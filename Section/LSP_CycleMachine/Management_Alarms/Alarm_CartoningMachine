(********************************************************************************
    Alarm_CartoningMachine - Mapping bitwise e bounds checks (per Sysmac)
    NOTE: versione specifica per CartoningMachine con Alarm IDs 0..60 (61 allarmi).
    Assume ALARMS_PER_BLOCK definita come VAR_GLOBAL CONSTANT (es. 64).
*********************************************************************************)



// ---------------------------------------------------------------------------
// 0) Prendi ALARMS_PER_BLOCK dalla costante globale (deve esistere a compile-time)
// ---------------------------------------------------------------------------
local_ALARMS_PER_BLOCK := ALARMS_PER_BLOCK; // se non è definita la build fallisce: comportamento desiderato

// Protezione runtime su valore non sensato (fallback sicuro)
IF local_ALARMS_PER_BLOCK <= 0 THEN
    local_ALARMS_PER_BLOCK := 16; // fallback sicuro (meglio definire la costante globalmente)
END_IF;

// ===========================================================================
// 1) Calcola NumGroups = ceil((MAX_ALARM_ID+1)/64)
// ===========================================================================
NumGroups := ((MAX_ALARM_ID_LOCAL + 1) + 63) / 64; // per 61 -> 1

// ===========================================================================
// 2) Popola NX_ImageLWORD per i gruppi effettivi
//    Per cartoning serve solo il primo LWORD (AlarmLINT0). Azzera eventuali altri.
// ===========================================================================
IF NumGroups >= 1 THEN
    NX_ImageLWORD[0].LW := LINT_TO_LWORD(AlarmLINT0);
END_IF;

FOR i := 1 TO NumGroups - 1 DO
    NX_ImageLWORD[i].LW := 0; // sicurezza se non esistono più AlarmLINT
END_FOR;

// ===========================================================================
// 3) Calcolo blocchi per scansione (ceil) e indici
// ===========================================================================
NUM_BLOCKS_LOCAL := ((MAX_ALARM_ID_LOCAL + 1) + local_ALARMS_PER_BLOCK - 1) / local_ALARMS_PER_BLOCK;

BlockStartIndex := BlockScanIndex * local_ALARMS_PER_BLOCK;
BlockEndIndex := BlockStartIndex + local_ALARMS_PER_BLOCK - 1;
IF BlockEndIndex > MAX_ALARM_ID_LOCAL THEN
    BlockEndIndex := MAX_ALARM_ID_LOCAL;
END_IF;

// ===========================================================================
// 4) Preparazione bounds per protezioni
// ===========================================================================
prevBitsUpper  := DINT_TO_INT( UPPER_BOUND(PreviousAlarmBits, 1)); 
analyticsUpper := DINT_TO_INT( UPPER_BOUND(ScadaInterface.Egress.AlarmAnalytics, 1)); 
packedUpper    := DINT_TO_INT( UPPER_BOUND(ScadaInterface.Egress.Alarms_Packed, 1));

// ===========================================================================
// 5) Process alarms nel blocco corrente con protezioni sui bounds
//    (sostituisce l'uso di CONTINUE con IF guards)
// ===========================================================================
FOR AlarmID := BlockStartIndex TO BlockEndIndex DO

    // Verifica che AlarmID sia valido prima di eseguire il corpo
    IF (AlarmID >= 0) AND (AlarmID <= MAX_ALARM_ID_LOCAL) THEN

        AlarmGroup := AlarmID / 64;      // 0 per AlarmID 0..63
        GroupBit   := AlarmID MOD 64;    // 0..63

        // Protezione accesso NX_ImageLWORD
        IF (AlarmGroup < 0) OR (AlarmGroup >= NumGroups) THEN
            CurrentAlarmBit := FALSE;
        ELSE
            IF (GroupBit >= 0) AND (GroupBit <= 63) THEN
                CurrentAlarmBit := NX_ImageLWORD[AlarmGroup].BL[GroupBit];
            ELSE
                CurrentAlarmBit := FALSE;
            END_IF;
        END_IF;

        // Rising edge detection con protezione bounds PreviousAlarmBits
        IF (AlarmID >= 0) AND (AlarmID <= prevBitsUpper) THEN
            RisingEdgeDetected := CurrentAlarmBit AND NOT PreviousAlarmBits[AlarmID];
        ELSE
            RisingEdgeDetected := CurrentAlarmBit; // se non posso leggere il precedente, tratta come nuovo
        END_IF;

        // Aggiorna AlarmAnalytics con protezione bounds
        IF (AlarmID >= 0) AND (AlarmID <= analyticsUpper) THEN
            ScadaInterface.Egress.AlarmAnalytics[AlarmID].State := CurrentAlarmBit;
            IF RisingEdgeDetected THEN
                ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count := ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count + 1;
            END_IF;
            IF CurrentAlarmBit THEN
                ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms := 
                    ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms + LastScanCycleTime_ms;
            END_IF;
        END_IF;

        // Aggiorna PreviousAlarmBits se possibile
        IF (AlarmID >= 0) AND (AlarmID <= prevBitsUpper) THEN
            PreviousAlarmBits[AlarmID] := CurrentAlarmBit;
        END_IF;

    END_IF; // fine validazione AlarmID

END_FOR;

// ===========================================================================
// 6) Aggiorna BlockScanIndex in modo sicuro
// ===========================================================================
BlockScanIndex := BlockScanIndex + 1;
IF BlockScanIndex >= NUM_BLOCKS_LOCAL THEN
    BlockScanIndex := 0;
END_IF;

// ===========================================================================
// 7) Calcolo MTTR/MTBF per gli allarmi del blocco (mantieni logica originale)
//    Anche qui evitiamo CONTINUE usando IF guards
// ===========================================================================
FOR AlarmID := BlockStartIndex TO BlockEndIndex DO

    IF (AlarmID >= 0) AND (AlarmID <= MAX_ALARM_ID_LOCAL) AND
       (AlarmID <= analyticsUpper) AND
       (ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count > 0) AND
       ( (CycleCount MOD 10) = 0 OR ScadaInterface.Egress.AlarmAnalytics[AlarmID].MTTR_sec = 0.0 ) THEN

        IF CachedTotalTime_sec = 0.0 THEN
            CachedTotalTime_sec := LINT_TO_LREAL(MachineAnalytics.TimeAnalytics.TotalTime.Hours * 3600 + 
                                                 MachineAnalytics.TimeAnalytics.TotalTime.Minutes * 60);
        END_IF;

        ScadaInterface.Egress.AlarmAnalytics[AlarmID].MTTR_sec := 
            (LINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms) / 1000.0) 
            / DINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count);

        TotalActiveTime_sec := LINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms) / 1000.0;

        ScadaInterface.Egress.AlarmAnalytics[AlarmID].MTBF_h :=
            ((CachedTotalTime_sec - TotalActiveTime_sec) / DINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count)) / 3600.0;

    END_IF;

END_FOR;

// Reset cache e incremento cycle count (come prima)
CachedTotalTime_sec := 0.0;
CycleCount := CycleCount + 1;
IF CycleCount >= 10000 THEN
    CycleCount := 0;
END_IF;

// ===========================================================================
// 8) TopAlarmScanIndex: usa modulo (MAX_ALARM_ID+1)
// ===========================================================================
TopAlarmScanIndex := (TopAlarmScanIndex + 1) MOD (MAX_ALARM_ID_LOCAL + 1);

// ===========================================================================
// 9) Copia LWORD -> Packed usando NumGroups e protezioni
// ===========================================================================
IF (packedUpper >= 0) THEN
    FOR i := 0 TO NumGroups - 1 DO
        FOR k := 0 TO 3 DO
            IF (i*4 + k) <= packedUpper THEN
                ScadaInterface.Egress.Alarms_Packed[i*4 + k] := NX_ImageLWORD[i].W[k];
            END_IF;
        END_FOR;
    END_FOR;
END_IF;

(********************************************************************************
    NOTE:
    - Questa versione evita CONTINUE (non supportato da Omron) e usa IF guard per
      eseguire il corpo del ciclo solo quando gli indici sono validi.
    - Assicurati che le variabili globali (ALARM_PER_BLOCK, PreviousAlarmBits, 
      ScadaInterface.Egress.AlarmAnalytics, NX_ImageLWORD, ecc.) siano dichiarate
      con dimensioni compatibili.
*********************************************************************************)