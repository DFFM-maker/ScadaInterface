(********************************************************************************
    Section: Alarm_Analytics
    Description: Scans all alarms, calculates advanced KPIs (Downtime, MTTR, MTBF),
                 and manages the Top Alarm lists.
*********************************************************************************)

// --- 1. Get Last Scan Cycle Time & Initialize ---
LastScanCycleTime := T#8ms; // Placeholder - Replace with actual scan time retrieval
LastScanCycleTime_ms := TimeToNanoSec(LastScanCycleTime) / 1000000;

// --- Costanti per ottimizzazione block-based scanning ---
MAX_ALARM_ID := 1343; // Massimo ID allarme (1344 allarmi totali: 0-1343)
ALARMS_PER_BLOCK := 64; // Numero di allarmi da processare per blocco (riduce carico CPU)
NUM_BLOCKS := (MAX_ALARM_ID + 1) / ALARMS_PER_BLOCK; // Numero totale di blocchi (21 blocchi)

// --- Variabili per block-based scanning ---
BlockScanIndex : INT := 0; // Indice del blocco corrente da processare
BlockStartIndex : INT; // Indice di inizio del blocco corrente
BlockEndIndex : INT; // Indice di fine del blocco corrente

// --- Variabili per caching MTTR/MTBF ---
CycleCount : INT := 0; // Contatore cicli per calcolo MTTR/MTBF ogni 10 cicli
CachedTotalTime_sec : LREAL := 0.0; // Cache per tempo totale monitorato
TotalActiveTime_sec : LREAL; // Variabile temporanea per calcolo MTBF

// --- 2. Initialize Top Alarm Data on First Run ---
IF P_First_Run THEN
    FOR i := 0 TO 99 DO
        // Initialize the Frequency list
        ScadaInterface.Egress.TopAlarms_ByFrequency[i].AlarmId := -1; // -1 indicates an empty slot
        ScadaInterface.Egress.TopAlarms_ByFrequency[i].Value   := 0.0;

        // Initialize the Downtime list
        ScadaInterface.Egress.TopAlarms_ByDowntime[i].AlarmId := -1;
        ScadaInterface.Egress.TopAlarms_ByDowntime[i].Value   := 0.0;
    END_FOR;
END_IF;

// --- 3. Create Raw Alarm Image (Mapping) ---

NX_ImageLWORD[0].LW  := LINT_TO_LWORD(AlarmLINT0);
NX_ImageLWORD[1].LW  := LINT_TO_LWORD(AlarmLINT4);
NX_ImageLWORD[2].LW  := LINT_TO_LWORD(AlarmLINT8);
NX_ImageLWORD[3].LW  := LINT_TO_LWORD(AlarmLINT12);
NX_ImageLWORD[4].LW  := LINT_TO_LWORD(AlarmLINT16);
NX_ImageLWORD[5].LW  := LINT_TO_LWORD(AlarmLINT20);
NX_ImageLWORD[6].LW  := LINT_TO_LWORD(AlarmLINT24);
NX_ImageLWORD[7].LW  := LINT_TO_LWORD(AlarmLINT28);
NX_ImageLWORD[8].LW  := LINT_TO_LWORD(AlarmLINT32);
NX_ImageLWORD[9].LW  := LINT_TO_LWORD(AlarmLINT36);
NX_ImageLWORD[10].LW := LINT_TO_LWORD(AlarmLINT40);
NX_ImageLWORD[11].LW := LINT_TO_LWORD(AlarmLINT44);
NX_ImageLWORD[12].LW := LINT_TO_LWORD(AlarmLINT48);
NX_ImageLWORD[13].LW := LINT_TO_LWORD(AlarmLINT52);
NX_ImageLWORD[14].LW := LINT_TO_LWORD(AlarmLINT56);
NX_ImageLWORD[15].LW := LINT_TO_LWORD(AlarmLINT60);
NX_ImageLWORD[16].LW := LINT_TO_LWORD(AlarmLINT64);
NX_ImageLWORD[17].LW := LINT_TO_LWORD(AlarmLINT68);
NX_ImageLWORD[18].LW := LINT_TO_LWORD(AlarmLINT72);
NX_ImageLWORD[19].LW := LINT_TO_LWORD(AlarmLINT76);
NX_ImageLWORD[20].LW := LINT_TO_LWORD(AlarmLINT82);

// --- 4. Process Alarms in Blocks (Optimized Block-Based Scanning) ---
// Processa un blocco di allarmi per ciclo per ridurre il carico CPU

// Calcola gli indici di inizio e fine per il blocco corrente
BlockStartIndex := BlockScanIndex * ALARMS_PER_BLOCK;
BlockEndIndex := BlockStartIndex + ALARMS_PER_BLOCK - 1;
IF BlockEndIndex > MAX_ALARM_ID THEN
    BlockEndIndex := MAX_ALARM_ID;
END_IF;

// Processa solo il blocco corrente di allarmi
FOR AlarmID := BlockStartIndex TO BlockEndIndex DO
	
	AlarmGroup := AlarmID / 64; // Divisione intera
    GroupBit   := AlarmID MOD 64; // Resto della divisione
    // Calculate LWORD group and bit index
	
    // Estrai il bit dell'allarme corrente
    CurrentAlarmBit := NX_ImageLWORD[AlarmGroup].BL[GroupBit];
    
    // Rilevamento manuale del fronte di salita
    RisingEdgeDetected := CurrentAlarmBit AND NOT PreviousAlarmBits[AlarmID];

    // --- Aggiorna la Struttura di Analisi SCADA ---
    ScadaInterface.Egress.AlarmAnalytics[AlarmID].State := CurrentAlarmBit;

    IF RisingEdgeDetected THEN
        ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count := ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count + 1;
    END_IF;

    IF CurrentAlarmBit THEN
        ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms := 
            ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms + LastScanCycleTime_ms;
    END_IF;

    // Memorizza lo stato attuale per il confronto al prossimo ciclo
    PreviousAlarmBits[AlarmID] := CurrentAlarmBit;
END_FOR;

// Aggiorna l'indice del blocco per il prossimo ciclo
BlockScanIndex := BlockScanIndex + 1;
IF BlockScanIndex >= NUM_BLOCKS THEN
    BlockScanIndex := 0;
END_IF;

// --- Calcolo MTTR e MTBF (ulteriormente ottimizzato con caching) ---
// Calcola MTTR/MTBF solo per gli allarmi del blocco corrente e solo quando necessario
FOR AlarmID := BlockStartIndex TO BlockEndIndex DO
    // Calcola MTTR/MTBF solo se l'allarme ha avuto attivazioni e solo ogni 10 cicli per ridurre i calcoli
    IF ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count > 0 AND (CycleCount MOD 10 = 0 OR 
        ScadaInterface.Egress.AlarmAnalytics[AlarmID].MTTR_sec = 0.0) THEN
        
        // Cache il tempo totale monitorato per evitare calcoli ripetuti
        IF CachedTotalTime_sec = 0.0 THEN
            CachedTotalTime_sec := LINT_TO_LREAL(MachineAnalytics.TimeAnalytics.TotalTime.Hours * 3600 + 
                                               MachineAnalytics.TimeAnalytics.TotalTime.Minutes * 60);
        END_IF;
        
        // Calcolo MTTR (Mean Time To Repair)
        ScadaInterface.Egress.AlarmAnalytics[AlarmID].MTTR_sec := 
            (LINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms) / 1000.0) 
            / DINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count);

        // Calcolo MTBF (Mean Time Between Failures)
        TotalActiveTime_sec := LINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].TotalActiveTime_ms) / 1000.0;
        
        ScadaInterface.Egress.AlarmAnalytics[AlarmID].MTBF_h :=
            ((CachedTotalTime_sec - TotalActiveTime_sec) / DINT_TO_LREAL(ScadaInterface.Egress.AlarmAnalytics[AlarmID].Count)) / 3600.0;
    END_IF;
END_FOR;

// Resetta la cache del tempo totale ogni ciclo
CachedTotalTime_sec := 0.0;

// Incrementa il contatore cicli
CycleCount := CycleCount + 1;
IF CycleCount >= 10000 THEN
    CycleCount := 0; // Resetta per evitare overflow
END_IF;

(********************************************************************************
    Section: Alarm_Analytics - PART 3: Periodic Update of Top Alarm Lists
    Description: Periodically scans alarms and updates the Top Alarm lists
                 using a robust, multi-step logic. (Final Guaranteed Version)
*********************************************************************************)

// Blinker logic to generate periodic trigger pulses
T_Off(IN := NOT T_On.Q AND EnableBlinker, PT := PeriodoOff);; // Off timer starts when On timer is off
T_On(IN := T_Off.Q AND EnableBlinker, PT := PeriodoOn);   // On timer starts when Off timer is on
PulseTrig(CLK := T_On.Q);                                          // Trigger pulse on rising edge of On timer

// This logic executes only on the rising edge of a periodic trigger pulse (PulseTrig.Q)
IF PulseTrig.Q THEN


    // We scan a small block of alarms each period to distribute the CPU load
    FOR j := 0 TO (ALARMS_TO_SCAN_PER_PERIOD - 1) DO
        
        CurrentAlarmID_ToCheck := ScanIndex;
        
        //======================================================================
        // 1. UPDATE TOP ALARMS BY FREQUENCY
        //======================================================================
        CurrentAlarmFrequency  := ScadaInterface.Egress.AlarmAnalytics[CurrentAlarmID_ToCheck].Count;
        
        // --- Step A: Check if this alarm is already in the list ---
        IsAlreadyInList := FALSE;
        FOR y := 0 TO 99 DO
            IF ScadaInterface.Egress.TopAlarms_ByFrequency[y].AlarmId = CurrentAlarmID_ToCheck THEN
                // It is already in the list, just update its value and we are done with this alarm.
                ScadaInterface.Egress.TopAlarms_ByFrequency[y].Value := DINT_TO_LREAL(CurrentAlarmFrequency);
                IsAlreadyInList := TRUE;
                EXIT;
            END_IF;
        END_FOR;

        // --- Step B: If not in the list, find the entry with the LOWEST frequency to replace ---
        IF NOT IsAlreadyInList THEN
            MinFrequencyInTopList := ScadaInterface.Egress.TopAlarms_ByFrequency[0].Value;
            IndexToUpdate := 0;
            FOR y := 1 TO 99 DO
                IF ScadaInterface.Egress.TopAlarms_ByFrequency[y].Value < MinFrequencyInTopList THEN
                    MinFrequencyInTopList := ScadaInterface.Egress.TopAlarms_ByFrequency[y].Value;
                    IndexToUpdate := y;
                END_IF;
            END_FOR;

            // --- Step C: Replace the minimum entry if the current alarm has a higher frequency ---
            IF DINT_TO_LREAL(CurrentAlarmFrequency) > MinFrequencyInTopList THEN
                ScadaInterface.Egress.TopAlarms_ByFrequency[IndexToUpdate].AlarmId := CurrentAlarmID_ToCheck;
                ScadaInterface.Egress.TopAlarms_ByFrequency[IndexToUpdate].Value   := DINT_TO_LREAL(CurrentAlarmFrequency);
            END_IF;
        END_IF;


        //======================================================================
        // 2. UPDATE TOP ALARMS BY DOWNTIME (la logica è identica)
        //======================================================================
        CurrentAlarmDowntime := ScadaInterface.Egress.AlarmAnalytics[CurrentAlarmID_ToCheck].TotalActiveTime_ms;

        IsAlreadyInList := FALSE;
        FOR y := 0 TO 99 DO
            IF ScadaInterface.Egress.TopAlarms_ByDowntime[y].AlarmId = CurrentAlarmID_ToCheck THEN
                ScadaInterface.Egress.TopAlarms_ByDowntime[y].Value := LINT_TO_LREAL(CurrentAlarmDowntime);
                IsAlreadyInList := TRUE;
                EXIT;
            END_IF;
        END_FOR;

        IF NOT IsAlreadyInList THEN
            MinDowntimeInTopList := ScadaInterface.Egress.TopAlarms_ByDowntime[0].Value;
            IndexToUpdate := 0;
            FOR y := 1 TO 99 DO
                IF ScadaInterface.Egress.TopAlarms_ByDowntime[y].Value < MinDowntimeInTopList THEN
                    MinDowntimeInTopList := ScadaInterface.Egress.TopAlarms_ByDowntime[y].Value;
                    IndexToUpdate := y;
                END_IF;
            END_FOR;

            IF LINT_TO_LREAL(CurrentAlarmDowntime) > MinDowntimeInTopList THEN
                ScadaInterface.Egress.TopAlarms_ByDowntime[IndexToUpdate].AlarmId := CurrentAlarmID_ToCheck;
                ScadaInterface.Egress.TopAlarms_ByDowntime[IndexToUpdate].Value   := LINT_TO_LREAL(CurrentAlarmDowntime);
            END_IF;
        END_IF;

        // Move to the next alarm ID for the next periodic check
        ScanIndex := (ScanIndex + 1) MOD MAX_ALARM_ID;
        
    END_FOR;

END_IF;

// --- 6. Data Conversion for Packed Alarms ---

// Copies data from NX_ImageLWORD (Word array) to Scada_Mes_EthIP.Scada_Mes_Egress.Allarms_DWord (DWord array)
// Reorganizes data: 4 Words from NX_ImageLWORD become 1 DWord in Allarms_DWord
FOR i := 0 TO 24 BY 1 DO
    FOR k := 0 TO 3 BY 1 DO
        ScadaInterface.Egress.Alarms_Packed[i*4 + k] := NX_ImageLWORD[i].W[k];
    END_FOR;
END_FOR;