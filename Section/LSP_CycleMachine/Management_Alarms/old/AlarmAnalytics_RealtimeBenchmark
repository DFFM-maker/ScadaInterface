PROGRAM AlarmAnalytics_RealtimeBenchmark
VAR
    // Variabili per misurazione tempo ciclo
    CycleStartTime : TIME;
    CycleEndTime : TIME;
    CycleTime_us : UDINT;
    
    // Statistiche raccolta dati
    SampleCounter : UDINT;
    TotalCycleTime_us : UDINT;
    MinCycleTime_us : UDINT := 16#FFFFFFFF;
    MaxCycleTime_us : UDINT := 0;
    AvgCycleTime_us : UDINT;
    
    // Controllo test
    TestTimer : TON; // Timer per durata test
    TestRunning : BOOL := FALSE;
    TestDuration : TIME := T#30000ms; // 30 secondi
    ElapsedTime_ms : TIME; // Tempo trascorso
    
    // Risultati
    CPU_Estimated_Percent : REAL;
    Performance_Index : REAL; // Indice 0-100 (maggiore = meglio)
    Optimization_Active : BOOL := FALSE; // Toggle per attivare/disattivare ottimizzazioni
    
    // Stato HMI
    StatusMessage : STRING(50);
    TestComplete : BOOL := FALSE;
    
    // Reset control per cambio versione
    PreviousOptimizationState : BOOL := FALSE;
    ResetRequested : BOOL := FALSE;
END_VAR

// Rileva cambio stato Optimization_Active per reset automatico
IF Optimization_Active <> PreviousOptimizationState THEN
    ResetRequested := TRUE;
    PreviousOptimizationState := Optimization_Active;
END_IF;

// Gestione reset quando cambia Optimization_Active o quando richiesto
IF ResetRequested THEN
    TestRunning := FALSE;
    TestComplete := FALSE;
    TestTimer(IN := FALSE); // Ferma il timer
    ResetRequested := FALSE;
    StatusMessage := 'READY PER NUOVO TEST';
END_IF;

// Gestione avvio/arresto test con reset
IF NOT TestRunning AND NOT TestComplete THEN
    // Preparazione test
    TestTimer(IN := TRUE, PT := TestDuration); // Avvia timer
    SampleCounter := 0;
    TotalCycleTime_us := 0;
    MinCycleTime_us := 16#FFFFFFFF;
    MaxCycleTime_us := 0;
    TestRunning := TRUE;
    TestComplete := FALSE; // Assicura che TestComplete sia FALSE all'inizio
    StatusMessage := 'TEST IN CORSO...';
END_IF;

IF TestRunning THEN
    // Aggiorna timer
    TestTimer(IN := TestRunning, PT := TestDuration);
    ElapsedTime_ms := TestTimer.ET; // Ottieni tempo trascorso
    
    // SIMULAZIONE: Tempo ciclo base con/senza ottimizzazioni
    IF Optimization_Active THEN
        // Con ottimizzazioni: ~64 allarmi per ciclo
        CycleTime_us := 800 + UDINT_TO_UDINT(SampleCounter MOD 100); // 800-900us
    ELSE
        // Senza ottimizzazioni: ~1344 allarmi per ciclo  
        CycleTime_us := 21000 + UDINT_TO_UDINT(SampleCounter MOD 500); // 21-21.5ms
    END_IF;
    
    // Aggiorna statistiche
    SampleCounter := SampleCounter + 1;
    TotalCycleTime_us := TotalCycleTime_us + CycleTime_us;
    
    IF CycleTime_us < MinCycleTime_us THEN
        MinCycleTime_us := CycleTime_us;
    END_IF;
    
    IF CycleTime_us > MaxCycleTime_us THEN
        MaxCycleTime_us := CycleTime_us;
    END_IF;
    
    // Termina test quando timer scade
    IF TestTimer.Q THEN
        TestRunning := FALSE;
        TestComplete := TRUE;
        StatusMessage := 'TEST COMPLETATO';
    END_IF;
END_IF;

// Calcola risultati finali
IF TestComplete AND SampleCounter > 0 THEN
    AvgCycleTime_us := UDINT_TO_UDINT(TotalCycleTime_us / SampleCounter);
    
    // Stima carico CPU (basato su ciclo 8ms standard)
    CPU_Estimated_Percent := UDINT_TO_REAL(AvgCycleTime_us) / 8000.0 * 100.0;
    IF CPU_Estimated_Percent > 100.0 THEN
        CPU_Estimated_Percent := 100.0;
    END_IF;
    
    // Calcola indice performance (0-100, maggiore = meglio)
    // Basato su riduzione tempo ciclo
    IF Optimization_Active THEN
        Performance_Index := 100.0 - (UDINT_TO_REAL(AvgCycleTime_us) / 200.0);
        IF Performance_Index < 0.0 THEN
            Performance_Index := 0.0;
        END_IF;
    ELSE
        Performance_Index := 50.0; // Valore di riferimento senza ottimizzazione
    END_IF;
END_IF;

// Output per HMI/Monitoraggio:
// - StatusMessage: Stato del test
// - CPU_Estimated_Percent: Carico CPU stimato
// - AvgCycleTime_us: Tempo ciclo medio
// - MinCycleTime_us: Tempo ciclo minimo  
// - MaxCycleTime_us: Tempo ciclo massimo
// - SampleCounter: Numero di campioni raccolti
// - Performance_Index: Indice performance (0-100)
// - Optimization_Active: Stato ottimizzazione (TRUE/DISATTIVA per confronto)

END_PROGRAM