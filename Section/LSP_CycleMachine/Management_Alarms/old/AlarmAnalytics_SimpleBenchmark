PROGRAM AlarmAnalytics_SimpleBenchmark
VAR
    // Timer per misurazione tempo
    BenchmarkTimer : TON;
    TestDuration : TIME := T#30s; // 30 secondi
    
    // Contatori performance
    CycleCounter : UDINT;
    TotalProcessingTime_us : UDINT;
    MinProcessingTime_us : UDINT := 16#FFFFFFFF;
    MaxProcessingTime_us : UDINT := 0;
    AvgProcessingTime_us : UDINT;
    
    // Risultati
    CPU_Estimated_Percent : REAL;
    AlarmsProcessedPerSecond : UDINT;
    OptimizationEfficiency : REAL;
    
    // Controllo test
    TestRunning : BOOL := FALSE;
    TestComplete : BOOL := FALSE;
    BenchmarkEnable : BOOL := TRUE; // TRUE = con ottimizzazioni, FALSE = senza
    
    // Stato HMI
    StatusMessage : STRING(50) := 'READY';
    ElapsedTime_ms : TIME;
END_VAR

// Gestione avvio/arresto test
IF NOT TestRunning AND NOT TestComplete THEN
    // Avvia test
    TestRunning := TRUE;
    BenchmarkTimer(IN := TRUE, PT := TestDuration);
    CycleCounter := 0;
    TotalProcessingTime_us := 0;
    MinProcessingTime_us := 16#FFFFFFFF;
    MaxProcessingTime_us := 0;
    StatusMessage := 'TEST IN CORSO...';
END_IF;

// Durante il test
IF TestRunning THEN
    // Aggiorna timer
    BenchmarkTimer(IN := TestRunning, PT := TestDuration);
    ElapsedTime_ms := BenchmarkTimer.ET;
    
    // Simula processing (sostituisci con chiamata reale al tuo codice)
    CycleCounter := CycleCounter + 1;
    
    // Simula tempo processing base (con/senza ottimizzazioni)
    IF BenchmarkEnable THEN
        // Con ottimizzazioni: ~800us per elaborare 64 allarmi
        TotalProcessingTime_us := TotalProcessingTime_us + 800;
        IF 800 < MinProcessingTime_us THEN MinProcessingTime_us := 800; END_IF;
        IF 800 > MaxProcessingTime_us THEN MaxProcessingTime_us := 800; END_IF;
    ELSE
        // Senza ottimizzazioni: ~21000us per elaborare 1344 allarmi
        TotalProcessingTime_us := TotalProcessingTime_us + 21000;
        IF 21000 < MinProcessingTime_us THEN MinProcessingTime_us := 21000; END_IF;
        IF 21000 > MaxProcessingTime_us THEN MaxProcessingTime_us := 21000; END_IF;
    END_IF;
    
    // Termina quando timer scade
    IF BenchmarkTimer.Q THEN
        TestRunning := FALSE;
        TestComplete := TRUE;
        StatusMessage := 'TEST COMPLETATO';
    END_IF;
END_IF;

// Calcola risultati finali
IF TestComplete AND CycleCounter > 0 THEN
    // Tempo medio per ciclo
    AvgProcessingTime_us := TotalProcessingTime_us / CycleCounter;
    
    // Stima carico CPU (basato su ciclo 8ms)
    CPU_Estimated_Percent := UDINT_TO_REAL(AvgProcessingTime_us) / 8000.0 * 100.0;
    IF CPU_Estimated_Percent > 100.0 THEN
        CPU_Estimated_Percent := 100.0;
    END_IF;
    
    // Allarmi processati al secondo
    IF UDINT_TO_TIME(TotalProcessingTime_us) > T#0s THEN
        AlarmsProcessedPerSecond := UDINT_TO_UDINT((CycleCounter * 64) / (TotalProcessingTime_us / 1000000));
    ELSE
        AlarmsProcessedPerSecond := 0;
    END_IF;
    
    // Efficienza ottimizzazione
    IF BenchmarkEnable THEN
        // Con ottimizzazioni: ~96% riduzione (da 21000us a 800us)
        OptimizationEfficiency := 96.0;
    ELSE
        OptimizationEfficiency := 0.0;
    END_IF;
END_IF;

// OUTPUT PER HMI:
// StatusMessage: Stato del test
// ElapsedTime_ms: Tempo trascorso
// CycleCounter: Numero di cicli eseguiti
// CPU_Estimated_Percent: Carico CPU stimato
// AvgProcessingTime_us: Tempo processing medio
// MinProcessingTime_us: Tempo processing minimo
// MaxProcessingTime_us: Tempo processing massimo
// AlarmsProcessedPerSecond: Throughput
// OptimizationEfficiency: Efficienza ottimizzazione

END_PROGRAM