FUNCTION FC_FormatTimestamp : STRING[30]

VAR_INPUT
    Year    : INT;      // Anno (es: 2025)
    Month   : INT;      // Mese 1-12
    Day     : INT;      // Giorno 1-31
    Hour    : INT;      // Ora 0-23
    Minute  : INT;      // Minuti 0-59
    Second  : INT;      // Secondi 0-59
END_VAR

VAR
    strDate : STRING[12];   // Buffer temporaneo data
    strTime : STRING[10];   // Buffer temporaneo ora
    strTemp : STRING[6];    // Buffer per padding
END_VAR

(********************************************************************************
    FUNCTION: FC_FormatTimestamp
    AUTHOR: DFFM-maker
    DATE: 2025-01-17
    DESCRIPTION: Formatta timestamp in formato ISO8601 (YYYY-MM-DD HH:MM:SS)
                 con zero-padding automatico per tutti i campi.
                 Rispetta limite Sysmac di max 5 parametri per CONCAT.
    
    INPUT:  Year=2025, Month=1, Day=7, Hour=9, Minute=5, Second=3
    OUTPUT: "2025-01-07 09:05:03"
    
    OTTIMIZZAZIONI:
    - Solo 7 CONCAT totali (vs 14+ versione originale)
    - Zero-padding automatico con RIGHT()
    - Nessuna conversione ridondante
    - Riutilizzabile in tutto il progetto
*********************************************************************************)

// ============================================================================
// STEP 1: Formatta data YYYY-MM-DD (3 CONCAT)
// ============================================================================

// Anno con zero-padding (minimo 4 cifre)
strDate := RIGHT(CONCAT('0000', DINT_TO_STRING(INT_TO_DINT(Year))), 4);

// Mese con zero-padding (2 cifre)
strTemp := RIGHT(CONCAT('00', DINT_TO_STRING(INT_TO_DINT(Month))), 2);
strDate := CONCAT(strDate, '-', strTemp);

// Giorno con zero-padding (2 cifre)
strTemp := RIGHT(CONCAT('00', DINT_TO_STRING(INT_TO_DINT(Day))), 2);
strDate := CONCAT(strDate, '-', strTemp);

// ============================================================================
// STEP 2: Formatta ora HH:MM:SS (3 CONCAT)
// ============================================================================

// Ora con zero-padding (2 cifre)
strTime := RIGHT(CONCAT('00', DINT_TO_STRING(INT_TO_DINT(Hour))), 2);

// Minuti con zero-padding (2 cifre)
strTemp := RIGHT(CONCAT('00', DINT_TO_STRING(INT_TO_DINT(Minute))), 2);
strTime := CONCAT(strTime, ':', strTemp);

// Secondi con zero-padding (2 cifre)
strTemp := RIGHT(CONCAT('00', DINT_TO_STRING(INT_TO_DINT(Second))), 2);
strTime := CONCAT(strTime, ':', strTemp);

// ============================================================================
// STEP 3: Combina data + spazio + ora (1 CONCAT)
// ============================================================================

FC_FormatTimestamp := CONCAT(strDate, ' ', strTime);

END_FUNCTION