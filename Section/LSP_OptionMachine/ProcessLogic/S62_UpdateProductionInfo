    HMI_OnLineData.HMI.OverlapCallNumber := +322;
    HMI_OnLineData.HMI.WriteArea_Overlap1 := TRUE;
ELSE
    HMI_OnLineData.HMI.WriteArea_Overlap1 := FALSE;
	    IF ProductionChange_State <> WaitingForHMI THEN
        MachineAnalytics.HMI_Interface.ActivateUpdatePopup := FALSE;
    END_IF;
END_IF;*)

// Reset the ACK to SCADA once the request from SCADA is gone
IF NOT ScadaInterface.Ingress.ProductionChangeRequest THEN
    ScadaInterface.Egress.ProductionChangeACK := FALSE;
END_IF;